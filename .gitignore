# ============================================================
# AI Data Analyst Agent — .gitignore
# ============================================================

# ---- Secrets / externalized config (requirement 13.7) ----
# NEVER commit API keys, passwords, or other secrets.
application-secrets.yml
**/application-secrets.yml
.env
*.env

# ---- Maven ----
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---- IDE / Editor ----
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Java ----
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ---- Logs ----
*.log
logs/

# ---- Spring Boot ----
spring-shell.log

# ---- OS ----
.DS_Store
ehthumbs.db
Desktop.ini

# ---- Node / Angular (frontend) ----
node_modules/
dist/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
